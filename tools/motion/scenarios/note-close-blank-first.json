{
  "name": "note-close-blank-first",
  "title": "A note that starts with empty lines, closed into its card (#322)",
  "issue": 322,
  "platforms": [
    "android",
    "mockup-android"
  ],
  "description": "Design 5.5. A card's title is the note's first line that holds anything (Outline::of). Closing a note whose first two lines are empty, its words ride from that line onto the title, not from the field's top, which would put an empty line on the title and the first words on the card's preview. The probe sees the page's body, not where its glyphs are: the body's last translation in the trace says where the words went (from the field's top, two lines further down), and the mockup's frames show the words.",
