{
  "name": "note-open-close",
  "title": "A note opened from the list and closed with Done (#322)",
  "issue": 322,
  "platforms": ["desktop", "android", "mockup-desktop", "mockup-android"],
  "description": "Design 5.5. Desktop: the note's text comes from the direction of the list, 18 px (snap); let go, its words fade where they were (140 ms, exit) and the row's highlight fades (150 ms). Android: the note grows out of its card (440 ms, enter; its text rises 14 px behind it, 380 ms from 60 ms) and shrinks back into it (340 ms, standard).",
  "setup": [
    { "platforms": ["desktop"], "click": "[data-dui-typed]" },
    { "platforms": ["desktop"], "type": "A thought about the garden, first of three" },
    { "platforms": ["desktop"], "wait": 900 },
    { "platforms": ["desktop"], "key": "Escape", "then": 1600 },
    { "platforms": ["desktop"], "click": "[data-dui-typed]" },
    { "platforms": ["desktop"], "type": "Buy string for the bean poles, second of three" },
    { "platforms": ["desktop"], "wait": 900 },
    { "platforms": ["desktop"], "key": "Escape", "then": 1600 },
    { "platforms": ["desktop"], "click": "[data-dui-typed]" },
    { "platforms": ["desktop"], "type": "Ask about the allotment waiting list, third of three" },
    { "platforms": ["desktop"], "wait": 900 },
    { "platforms": ["desktop"], "key": "Escape", "then": 2000 },
    { "platforms": ["android"], "tap": ".dm-bar", "then": 1200 },
    { "platforms": ["android"], "tap": ".dm-text", "then": 400 },
    { "platforms": ["android"], "type": "A thought about the garden, first of three", "then": 1200 },
    { "platforms": ["android"], "tap": ".dm-page-bar button[aria-label='Done']", "repeatUntilGone": ".dui-grow.dm-page.on", "then": 1800 },
    { "platforms": ["android"], "tap": ".dm-bar", "then": 1200 },
    { "platforms": ["android"], "tap": ".dm-text", "then": 400 },
    { "platforms": ["android"], "type": "Buy string for the bean poles, second of three", "then": 1200 },
    { "platforms": ["android"], "tap": ".dm-page-bar button[aria-label='Done']", "repeatUntilGone": ".dui-grow.dm-page.on", "then": 1800 },
    { "platforms": ["android"], "tap": ".dm-bar", "then": 1200 },
    { "platforms": ["android"], "tap": ".dm-text", "then": 400 },
    { "platforms": ["android"], "type": "Ask about the allotment waiting list, third of three", "then": 1200 },
    { "platforms": ["android"], "tap": ".dm-page-bar button[aria-label='Done']", "repeatUntilGone": ".dui-grow.dm-page.on", "then": 2200 },
    { "platforms": ["mockup"], "wait": 500 }
  ],
  "parts": {
    "page": { "desktop": ".dk-col", "android": ".dui-grow.dm-page", "mockup-desktop": "#d-ed", "mockup-android": "#m-ed" },
    "text": { "desktop": ".dk-text", "android": ".dm-page-body", "mockup-desktop": "#d-text", "mockup-android": "#m-ed .m-ed-body" },
    "bar": { "android": ".dm-page-bar", "mockup-android": "#m-ed .m-ed-bar" },
    "gutter": { "desktop": ".dk-gutter" },
    "card": {
      "desktop": ".dk-side [role='option'][data-key]",
      "android": ".dm-list .dui-card",
      "mockup-desktop": "#d-list .row",
      "mockup-android": "#m-list .card-n"
    },
    "highlight": { "desktop": ".dui-sel-ind", "mockup-desktop": "#d-list .sel-ind" }
  },
  "crop": { "mockup-desktop": "#D", "mockup-android": "#M" },
  "checks": { "pops": { "px": 24, "opacity": 0.3 } },
  "movements": [
    {
      "name": "open",
      "description": "The second note in the list is pressed.",
      "steps": [
        {
          "click": {
            "desktop": ".dk-side [role='option'][data-key]",
            "android": ".dm-list .dui-card-in",
            "mockup-desktop": "#d-list .row",
            "mockup-android": "#m-list .card-in"
          },
          "index": 1
        }
      ],
      "ms": 1200
    },
    {
      "name": "close",
      "description": "Done is pressed: back to the list.",
      "steps": [
        {
          "click": {
            "desktop": ".dk-gutter button[aria-label='Done']",
            "android": ".dm-page-bar button[aria-label='Done']",
            "mockup-desktop": "#D [data-act='settle']",
            "mockup-android": "#M [data-act='m-back']"
          }
        }
      ],
      "leaves": { "android": ["page"], "mockup-android": ["page"] },
      "ms": 1200,
      "mirrors": {
        "of": "open",
        "parts": { "android": { "page": ["x", "y", "w", "h"] }, "mockup-android": { "page": ["x", "y", "w", "h"] } },
        "curve": false,
        "because": "design 5.5: on Android the note grows out of its card (440 ms, enter) and shrinks back into it (340 ms, standard); on the desktop a note let go only fades, by design, so nothing there is meant to mirror"
      }
    },
    {
      "name": "open-again",
      "description": "The second note is opened again, for the next movement.",
      "platforms": ["android"],
      "steps": [{ "tap": ".dm-list .dui-card-in", "index": 1 }],
      "ms": 1200
    },
    {
      "name": "done-then-bar",
      "description": "Done, and at once the bar, for the next thought (design 5.8, checklist A31): the page on its way out lets the tap through, and a new page opens out of the bar. It is then let go empty.",
      "platforms": ["android"],
      "steps": [{ "tap": ".dm-page-bar button[aria-label='Done']", "then": 120 }, { "tap": ".dm-bar" }],
      "arrives": ["page"],
      "after": [{ "tap": ".dm-page-bar button[aria-label='Done']", "then": 1200 }],
      "ms": 1400
    }
  ]
}
