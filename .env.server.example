# Server-side configuration (dirt-api only).
# These values must never reach a client binary.
#
# Copy to .env.server and fill in your values:
#   cp .env.server.example .env.server
#
# In production, set them on the hosting platform instead:
#   vercel env add DATABASE_URL production

# --- Where the local server listens ---
# Use 0.0.0.0 so the Android emulator can reach it at http://10.0.2.2:8080.
# Vercel ignores this; only `dirt-api serve` reads it.
DIRT_API_BIND_ADDR=0.0.0.0:8080

# --- Postgres ---
# The database the server reads and writes. For local work, `docker compose
# up -d` at the repository root starts one that this address reaches.
# In production this is Neon's POOLED connection string (the host contains
# "-pooler").
DATABASE_URL=postgres://postgres:dirt@127.0.0.1:55432/postgres

# Used only by `dirt-api migrate`. In production this is Neon's DIRECT
# connection string: the migration lock needs one unbroken session, which the
# pooled endpoint does not give.
MIGRATE_DATABASE_URL=postgres://postgres:dirt@127.0.0.1:55432/postgres

# --- Files ---
# Object storage for encrypted files, speaking the S3 protocol. Leave all of
# these out and the server syncs notes and refuses files. `docker compose up
# -d` starts a store that these values reach; in production they are a
# Cloudflare R2 bucket and a token limited to it (docs/DEPLOY.md).
FILES_S3_ENDPOINT=http://127.0.0.1:59000
FILES_S3_BUCKET=dirt-files
FILES_S3_REGION=us-east-1
FILES_S3_ACCESS_KEY_ID=dirt
FILES_S3_SECRET_ACCESS_KEY=dirt-local-files

# What the daily request that deletes expired files must present. Vercel
# sends it by itself when a variable of this name is set on the project.
# Without it nobody can make that request.
CRON_SECRET=

# --- Clerk ---
# The Clerk instance that signs ID tokens, without a trailing slash.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# The client ID of the Clerk OAuth application the clients sign in through.
# It is a public identifier, not a secret; it is here because the server
# refuses ID tokens issued for any other client.
CLERK_CLIENT_ID=
