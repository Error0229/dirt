# Client build-time configuration
# These values are read by build.rs and baked into the desktop app, the
# Android app and the CLI. Safe to embed: there are no secrets here.
#
# Copy to .env.client and fill in your values:
#   cp .env.client.example .env.client

# The server to sync with. It is all a client needs to know: the server
# tells it which sign-in service to use. Leave it empty and the app keeps
# its notes on the device and never signs in.
DIRT_API_BASE_URL=

# Optional overrides for one platform, for when the desktop app and the
# Android emulator need different names for a server on this machine. The
# desktop build rewrites 10.0.2.2 to 127.0.0.1 and the Android build the
# reverse.
DIRT_DESKTOP_API_BASE_URL=
DIRT_MOBILE_API_BASE_URL=

# The CLI and the desktop app on one computer are one device, so the CLI is
# built with the desktop app's address. For either, DIRT_API_BASE_URL in the
# environment when it starts comes before the address it was built with.
