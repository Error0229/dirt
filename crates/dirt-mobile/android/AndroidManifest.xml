<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No backup and no transfer to a new phone: Dirt's database and the
         thoughts waiting for it are not encrypted by Dirt, and its keys
         would not open elsewhere (res/xml/dirt_data_extraction.xml in
         android/native; docs/SECURITY.md). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/dirt_data_extraction"
        android:allowNativeHeapPointerTagging="false"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- singleTask: the sign-in redirect returns to the running activity
             through onNewIntent instead of starting a second one.
             The theme follows the system's light or dark, which is what the
             web view's Auto reads; uiMode is among the changes the activity
             takes itself, since restarting it would end the app. -->
        <activity
            android:configChanges="orientation|screenLayout|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <meta-data android:name="android.app.lib_name" android:value="dioxusmain" />
            <!-- A long press on the app's icon: New note, the capture sheet
                 (android/native). Android reads it from the launcher's
                 activity, so it is here and its list is there. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/dirt_shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- A shared picture, or several, becomes a note with the
                 pictures attached. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- The browser returns from sign-in to dev.dirt.app://callback.
                 Any app can claim a custom scheme; PKCE is what makes a
                 redirect taken by another app useless to it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.dirt.app" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- Lends one file at a time to another app, for reading, when the
             person opens a note's file. It is not open to other apps: each
             is given the one address it was sent, and nothing else. The
             only folder it can lend from is the one the app copies a file
             into to be opened (res/xml/dirt_file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dirt_file_paths" />
        </provider>
    </application>
</manifest>
