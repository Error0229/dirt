<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app's manifest by Gradle: every native way in to
     capture, declared beside its code (interface design 8.5, 8.6). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A job that waits for a network may not be asked for without this
         (found on Android 16 by the plan's second trial: SecurityException
         from schedule()). A normal permission: nobody is asked. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The job is kept across a restart of the phone (`setPersisted`), so
         that a thought kept offline is still made a note and synced. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Voice (design 6.18, 8.9): asked for at the first press of a mic,
         in Android's own dialog. Only while the person holds or has tapped
         a mic: nothing listens otherwise, and no service records in the
         background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A phone with no microphone still installs Dirt, and has no mic. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application>
        <!-- The capture sheet. A task of its own, with no affinity to the
             app's, so that opening it never brings the app's screen up
             under it; never among the recent apps. Turning the phone, or
             changing its theme or text size, does not make it again: it
             would close, and lose what was typed. It shows over the lock
             screen, where it adds and shows nothing (8.6). CREATE_NOTE
             makes it what Android's note-taking role opens, on phones that
             offer the role. -->
        <activity
            android:name="dev.dirt.capture.CaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/DirtCapture"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboard|keyboardHidden|density|fontScale|navigation"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Talk (6.18, 8.6): the sheet listening at once, ending on a
             pause. Among the apps as "Dirt Talk", so that a phone's
             hardware key (the side key's double press on Samsung, Quick
             Tap on Pixel) can be set to open it, over the lock screen
             too where the phone allows. Only in a build with voice
             (`dirt_voice_shipped`, which dirt-mobile's build.rs writes). -->
        <activity-alias
            android:name="dev.dirt.capture.Talk"
            android:enabled="@bool/dirt_voice_shipped"
            android:exported="true"
            android:icon="@drawable/dirt_talk"
            android:label="@string/dirt_talk_app"
            android:targetActivity="dev.dirt.capture.CaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The widget's mic: the sheet listening hands-free. Not exported,
             so that no other app can make the sheet listen; the widget's
             PendingIntent is Dirt's own. -->
        <activity-alias
            android:name="dev.dirt.capture.Listen"
            android:exported="false"
            android:targetActivity="dev.dirt.capture.CaptureActivity" />

        <!-- Makes the waiting recordings notes, and their words, on this
             phone; then asks for the job below. Asked for by the sheet's
             keeping of a recording and by nothing else. -->
        <service
            android:name="dev.dirt.capture.WordsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Makes the waiting thoughts notes and syncs once. Asked for by
             the sheet's tick and by nothing else. -->
        <service
            android:name="dev.dirt.capture.CaptureJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The Quick Settings tile, "New note". -->
        <service
            android:name="dev.dirt.capture.CaptureTile"
            android:exported="true"
            android:icon="@drawable/dirt_sprout"
            android:label="@string/dirt_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The home screen's bar. -->
        <receiver
            android:name="dev.dirt.capture.CaptureWidget"
            android:exported="true"
            android:label="@string/dirt_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dirt_capture_widget" />
        </receiver>
    </application>
</manifest>
