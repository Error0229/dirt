<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dirt_widget_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dirt_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/dirt_widget_bar"
        android:textColor="@color/dirt_text_quiet"
        android:textSize="16sp" />
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/dirt_tile_label"
        android:src="@drawable/dirt_tile"
        android:tint="@color/dirt_accent" />
</LinearLayout>
