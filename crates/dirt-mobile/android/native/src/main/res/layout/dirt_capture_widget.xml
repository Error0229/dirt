<?xml version="1.0" encoding="utf-8"?>
<!-- The widget (design 8.5): one bar. The logo opens the app at the list;
     the rest of the bar opens the capture sheet. It shows no notes: anyone
     who sees the home screen sees it. The mic comes with voice (step 9). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dirt_widget_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/dirt_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="20dp">
    <FrameLayout
        android:id="@+id/dirt_widget_logo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/dirt_open_dirt"
        android:padding="7dp">
        <ImageView
            android:id="@+id/dirt_widget_square"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/dirt_logo_square"
            android:tint="@color/dirt_accent_clay" />
        <ImageView
            android:id="@+id/dirt_widget_sprout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/dirt_sprout"
            android:tint="@color/dirt_on_accent_clay" />
    </FrameLayout>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/dirt_widget_bar"
        android:textColor="@color/dirt_text_3"
        android:textSize="16sp" />
</LinearLayout>
