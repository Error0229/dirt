<?xml version="1.0" encoding="utf-8"?>
<!-- A long press on the app's icon: New note, the capture sheet (8.1), and
     Talk, the sheet listening at once (6.18). A
     static shortcut names its target by package, and a resource cannot say
     ${applicationId}: the package is written out, and is the bundle's
     identifier in dirt-mobile's Dioxus.toml (tests/android_package.rs). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/dirt_shortcut"
        android:shortcutId="new_note"
        android:shortcutShortLabel="@string/dirt_new_note">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.dirt.capture.CaptureActivity"
            android:targetPackage="dev.catjam.dirt" />
    </shortcut>
    <!-- Only in a build with voice (`dirt_voice_shipped`, build.rs). -->
    <shortcut
        android:enabled="@bool/dirt_voice_shipped"
        android:icon="@drawable/dirt_talk"
        android:shortcutId="talk"
        android:shortcutShortLabel="@string/dirt_talk">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.dirt.capture.Talk"
            android:targetPackage="dev.catjam.dirt" />
    </shortcut>
</shortcuts>
