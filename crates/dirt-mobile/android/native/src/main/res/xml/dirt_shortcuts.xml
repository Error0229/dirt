<?xml version="1.0" encoding="utf-8"?>
<!-- Long press on the app's icon: New note. A static shortcut names its
     target by package, and a resource file cannot say ${applicationId}:
     the package is written out here and has to follow the app's. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/dirt_tile"
        android:shortcutId="new_note"
        android:shortcutShortLabel="@string/dirt_shortcut_new_note">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.dirt.capture.CaptureActivity"
            android:targetPackage="com.example.DirtMobile" />
    </shortcut>
</shortcuts>
