<?xml version="1.0" encoding="utf-8"?>
<!-- The one folder the app's file provider (the app's AndroidManifest.xml)
     may lend a file from: where a note's file is copied to be opened by
     another app. `files-path` is the app's own files folder, and
     `dirt/opened/` is the folder of copies under the app's data folder
     (`dirt-mobile`'s `files::opened_folder`). -->
<paths>
    <files-path name="opened" path="dirt/opened/" />
</paths>
