<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Dirt goes into Android's cloud backup or a transfer to a new
     phone (Android 12 and later; `allowBackup="false"` says the same to
     older Android). The database and the thoughts waiting in `dirt/` are
     not encrypted by Dirt, and the device's keys, in the encrypted
     preferences, would not open on another phone anyway. A new phone gets
     the notes by signing in and being let in (docs/SECURITY.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
