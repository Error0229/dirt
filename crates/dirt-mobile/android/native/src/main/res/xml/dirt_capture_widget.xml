<?xml version="1.0" encoding="utf-8"?>
<!-- Four cells wide at first, and resizable sideways down to one cell,
     where it is only its icons (8.5, 8.11). Nothing to redraw on a timer:
     it shows no notes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/dirt_widget_bar"
    android:initialLayout="@layout/dirt_capture_widget"
    android:minHeight="40dp"
    android:minWidth="250dp"
    android:minResizeWidth="40dp"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
