<?xml version="1.0" encoding="utf-8"?>
<!-- The capture sheet's, the widget's and the tile's words and look. The
     colours are in dirt_colours.xml, made from dirt_ui::tokens. -->
<resources>
    <!-- The app's name under its icon (the app's manifest). -->
    <string name="dirt_app_name">Dirt</string>
    <string name="dirt_capture_hint">What’s on your mind?</string>
    <string name="dirt_capture_done">Done</string>
    <string name="dirt_capture_locked">Adds a note. Your notes stay locked.</string>
    <string name="dirt_capture_not_kept">The thought could not be kept. It is still here.</string>
    <item name="dirt_capture_field" type="id" />
    <string name="dirt_widget_label">Dirt</string>
    <string name="dirt_widget_bar">Write a thought</string>
    <string name="dirt_open_dirt">Open Dirt</string>
    <string name="dirt_new_note">New note</string>
    <string name="dirt_pile_label">Dirt pile</string>
    <string name="dirt_pile_about">Your thoughts, as a pile of sand</string>
    <string name="dirt_pile_open">Open Dirt to see your pile</string>

    <!-- Voice (design 6.18, 8.9). -->
    <string name="dirt_talk">Talk</string>
    <string name="dirt_talk_app">Dirt Talk</string>
    <string name="dirt_mic">Hold to talk, or tap</string>
    <string name="dirt_mic_refused">Dirt may not use the microphone. Press to be asked again</string>
    <string name="dirt_mic_refused_for_good">Allow the microphone in Android’s Settings: Apps, Dirt, Permissions</string>
    <string name="dirt_mic_locked">Unlock the phone to let Dirt use the microphone</string>
    <string name="dirt_mic_failed">The microphone could not be used</string>
    <string name="dirt_throw_away">Throw away</string>
    <string name="dirt_listening">Listening</string>
    <string name="dirt_kept">Kept</string>
    <string name="dirt_thrown">Thrown away</string>
    <string name="dirt_nothing_heard">Nothing heard</string>
    <string name="dirt_voice_not_kept">What was said could not be kept</string>

    <!-- What dims the screen behind the sheet: the mockup's. -->
    <color name="dirt_scrim">#61140F0B</color>

    <!-- The sheet's window: drawn over whatever is on screen, which shows
         through around it. The sheet draws its own dimming and moves
         itself, so the window has no animation of its own. -->
    <style name="DirtCapture" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
